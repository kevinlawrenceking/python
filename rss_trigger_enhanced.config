# Enhanced RSS Trigger Configuration
# =================================
# Configuration file for docketwatch_rss_trigger_enhanced.py

[FEATURES]
# Enable automatic PDF download for new case events
ENABLE_PDF_DOWNLOAD = True

# Enable AI-powered document summarization
ENABLE_SUMMARIZATION = True

# Send enhanced email alerts with PDF summaries
ENHANCED_EMAIL_ALERTS = True

[PROCESSING]
# Timeout for PDF download process (seconds)
PDF_DOWNLOAD_TIMEOUT = 300

# Timeout for summarization process (seconds)
SUMMARIZATION_TIMEOUT = 120

# Delay between PDF download and summarization (seconds)
POST_DOWNLOAD_DELAY = 2

[SCRIPTS]
# Path to PDF processor script
PDF_PROCESSOR_SCRIPT = u:/docketwatch/python/combined_pacer_pdf_vprocessor.py

# Path to summarizer script
SUMMARIZER_SCRIPT = u:/docketwatch/python/summarize_document_event.py

[LOGGING]
# Enhanced logging for debugging
VERBOSE_LOGGING = True

# Log PDF download details
LOG_PDF_DETAILS = True

# Log summarization details
LOG_SUMMARY_DETAILS = True